{
  "name": "password-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:types": "tsc --build",
    "build:types:clean": "tsc --build --clean",
    "build:types:watch": "tsc --build --watch",
    "build:types:force": "tsc --build --force",
    "dev:web": "concurrently -k -n \"types,react\" -c \"blue,green\" \"pnpm build:types:watch\" \"pnpm --filter @password-manager/web dev\"",
    "dev:web:once": "pnpm build:types && pnpm --filter @password-manager/web dev",
    "build:web": "pnpm build:types && pnpm --filter @password-manager/web build",
    "prepare:electron": "./src/presentation/electron/scripts/prepare-web.sh",
    "build:electron:web": "cd src/presentation/electron/.build/web && pnpm vite build",
    "build:electron": "pnpm prepare:electron && pnpm build:electron:web",
    "typecheck": "tsc --build --force",
    "typecheck:web": "tsc -p src/presentation/web/react/tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern 'src/presentation'",
    "lint:web": "pnpm --filter @password-manager/web lint",
    "lint:fix": "eslint src --ignore-pattern 'src/presentation' --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-boundaries": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@sweet-monads/either": "^3.3.1"
  }
}
