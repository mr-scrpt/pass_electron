//  src/presentation/web/react/tsconfig.json
{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      // ✅ FSD слои (React код)
      "@/*": ["./src/*"],
      
      // ✅ DDD слои - ЕДИНСТВЕННЫЕ точки входа
      "@/main/composition": ["../../../composition/index.ts"],
      "@/main/shared": ["../../../shared/index.ts"],
      "@/main/shared/*": ["../../../shared/*"],
      
      // ✅ Presentation shared (переиспользуемые между платформами)  
      "@/platform": ["../../shared/platform/index.ts"],
      "@/platform/*": ["../../shared/platform/*"],
      "@/systems": ["../../shared/systems/index.ts"],
      "@/systems/*": ["../../shared/systems/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  
  // ✅ Project References
  "references": [
    { "path": "../../../../tsconfig.json" }      // DDD слои
  ],
  
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    "src/types/**/*.d.ts",        // ← Type definitions для CSS/images
    "../../shared/systems/**/*",  // ← Включаем systems напрямую
    "../../shared/platform/**/*"  // ← Включаем platform напрямую
  ]
}
